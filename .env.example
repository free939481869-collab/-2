# Gemini（现有比对功能）
GEMINI_API_KEY=
# GEMINI_API_BASE_URL=

# UICheck：仅用于本地代理 server/uicheck-proxy.mjs，勿提交真实 Token
# 只填 token 字符串即可；若误写成 "Bearer xxx"，代理会规范化
OMNIBUS_ACCESS_TOKEN=
# 可选，默认 connectors + api.mtatpro 网关前缀
# UICHECK_GATEWAY_BASE=https://connectors.meitu-int.com/gateway/api.mtatpro.meitu-int.com
# 本地代理端口（需与 vite 代理一致，默认 8787）
# UICHECK_PROXY_PORT=8787
